{
  "name": "trabahotracker",
  "version": "1.0.0",
  "description": "TrabahoTracker — offline desktop job application tracker",
  "main": "./out/main/index.js",
  "type": "module",
  "author": {
    "name": "Lumnaire",
    "url": "https://github.com/lumnaire"
  },
  "license": "MIT",
  "homepage": "https://github.com/lumnaire/TrabahoTracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumnaire/TrabahoTracker.git"
  },
  "bugs": {
    "url": "https://github.com/lumnaire/TrabahoTracker/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "npm run typecheck",
    "test": "tsx --test tests/status.test.ts tests/dates.test.ts tests/goals.test.ts",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}